{
  "name": "andwati-nextgen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "lint:content": "prettier --check \"content/**/*.md\" && cspell --no-progress",
    "format:content": "prettier --write \"content/**/*.md\"",
    "spell": "cspell --no-progress",
    "check": "biome check && pnpm lint:content",
    "prepare": "husky"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "katex": "^0.18.9",
    "next": "16.3.6",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "cspell": "^10.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.4.2",
  "lint-staged": {
    "content/**/*.md": [
      "prettier --write",
      "cspell --no-progress --no-must-find-files"
    ],
    "*.{ts,tsx,mjs,json,css}": "biome check --write --no-errors-on-unmatched"
  }
}
